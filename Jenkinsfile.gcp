pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
        jdk 'Java-17'
    }

    environment {
        // GCP Configuration
        GCP_PROJECT_ID = credentials('gcp-project-id')
        GCP_REGION = 'us-central1'
        GCP_ZONE = 'us-central1-a'

        // Application Configuration
        APP_NAME = 'pollingapp'

        // Artifact Registry Configuration
        ARTIFACT_REGISTRY = "us-central1-docker.pkg.dev/${GCP_PROJECT_ID}/pollingapp-repo"
        IMAGE_NAME = "${ARTIFACT_REGISTRY}/${APP_NAME}"
        IMAGE_TAG = "${BUILD_NUMBER}"

        // Cloud Run Configuration
        CLOUD_RUN_SERVICE = 'pollingapp'

        // Cloud SQL Configuration
        CLOUD_SQL_INSTANCE = credentials('cloud-sql-instance-name')
        DATABASE_NAME = 'pollingdb'
        DATABASE_USER = 'pollingapp_user'

        // Secrets
        DATABASE_PASSWORD = credentials('gcp-db-password')
        JWT_SECRET = credentials('jwt-secret')

        // GCP Service Account
        GCP_SERVICE_ACCOUNT = credentials('gcp-service-account')
    }

    stages {
        stage('Checkout') {
            steps {
                echo '========== Checking out source code =========='
                checkout scm
                echo 'Source code checkout completed ✓'
            }
        }

        stage('Setup GCP Authentication') {
            steps {
                echo '========== Authenticating with GCP =========='
                script {
                    // Activate service account
                    sh '''
                        gcloud auth activate-service-account \
                            --key-file=${GCP_SERVICE_ACCOUNT}

                        gcloud config set project ${GCP_PROJECT_ID}

                        # Configure Docker to use gcloud for authentication
                        gcloud auth configure-docker ${GCP_REGION}-docker.pkg.dev

                        echo "Authenticated as:"
                        gcloud auth list
                    '''
                }
                echo 'GCP authentication completed ✓'
            }
        }

        stage('Build Backend') {
            steps {
                echo '========== Building Spring Boot Application =========='
                sh 'mvn clean compile -DskipTests'
                echo 'Backend build completed ✓'
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo '========== Running Unit Tests =========='
                sh 'mvn test'
                echo 'Unit tests completed ✓'
            }
            post {
                always {
                    // Publish test results
                    junit '**/target/surefire-reports/*.xml'

                    // Publish test coverage (if using JaCoCo)
                    // jacoco execPattern: '**/target/jacoco.exec'
                }
            }
        }

        stage('Package Application') {
            steps {
                echo '========== Packaging Application =========='
                sh 'mvn package -DskipTests'
                echo 'Application packaging completed ✓'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        stage('Build Frontend') {
            tools {
                nodejs 'NodeJS-18'
            }
            steps {
                echo '========== Building React Frontend =========='
                dir('frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
                echo 'Frontend build completed ✓'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "========== Building Docker Image =========="
                script {
                    sh """
                        echo "Building image: ${IMAGE_NAME}:${IMAGE_TAG}"

                        docker build \
                            -t ${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME}:latest \
                            --build-arg JAR_FILE=target/*.jar \
                            .

                        echo "Docker image built successfully ✓"
                        docker images | grep ${APP_NAME}
                    """
                }
            }
        }

        stage('Push to Artifact Registry') {
            steps {
                echo '========== Pushing Docker Image to Artifact Registry =========='
                script {
                    sh """
                        echo "Pushing ${IMAGE_NAME}:${IMAGE_TAG}"
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}

                        echo "Pushing ${IMAGE_NAME}:latest"
                        docker push ${IMAGE_NAME}:latest

                        echo "Image pushed successfully ✓"
                    """
                }
            }
        }

        stage('Deploy to Cloud Run - Staging') {
            when {
                branch 'develop'
            }
            steps {
                echo '========== Deploying to Cloud Run (Staging) =========='
                script {
                    sh """
                        gcloud run deploy ${CLOUD_RUN_SERVICE}-staging \
                            --image=${IMAGE_NAME}:${IMAGE_TAG} \
                            --platform=managed \
                            --region=${GCP_REGION} \
                            --allow-unauthenticated \
                            --port=8080 \
                            --memory=512Mi \
                            --cpu=1 \
                            --min-instances=0 \
                            --max-instances=3 \
                            --set-env-vars="SPRING_PROFILES_ACTIVE=prod" \
                            --set-env-vars="DATABASE_NAME=${DATABASE_NAME}" \
                            --set-env-vars="DATABASE_USER=${DATABASE_USER}" \
                            --set-env-vars="DATABASE_PASSWORD=${DATABASE_PASSWORD}" \
                            --set-env-vars="JWT_SECRET=${JWT_SECRET}" \
                            --set-env-vars="CLOUD_SQL_INSTANCE_CONNECTION_NAME=${CLOUD_SQL_INSTANCE}" \
                            --add-cloudsql-instances=${CLOUD_SQL_INSTANCE} \
                            --timeout=300 \
                            --service-account=jenkins-deployer@${GCP_PROJECT_ID}.iam.gserviceaccount.com

                        echo "Deployment to Staging completed ✓"
                    """
                }
            }
        }

        stage('Run Integration Tests - Staging') {
            when {
                branch 'develop'
            }
            steps {
                echo '========== Running Integration Tests on Staging =========='
                script {
                    // Get the staging URL
                    def stagingUrl = sh(
                        script: "gcloud run services describe ${CLOUD_RUN_SERVICE}-staging --region=${GCP_REGION} --format='value(status.url)'",
                        returnStdout: true
                    ).trim()

                    echo "Staging URL: ${stagingUrl}"

                    // Wait for service to be ready
                    sh "sleep 20"

                    // Run health check
                    sh """
                        echo "Running health check..."
                        curl -f ${stagingUrl}/actuator/health || exit 1
                        echo "Health check passed ✓"
                    """

                    // You can add more integration tests here
                    // sh "mvn verify -Pintegration-tests -Dbase.url=${stagingUrl}"
                }
            }
        }

        stage('Approval for Production') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo '========== Waiting for Production Deployment Approval =========='

                    // Manual approval required for production
                    timeout(time: 24, unit: 'HOURS') {
                        input message: 'Deploy to Production?',
                              ok: 'Deploy',
                              submitter: 'admin',
                              submitterParameter: 'APPROVER'
                    }

                    echo 'Production deployment approved ✓'
                }
            }
        }

        stage('Deploy to Cloud Run - Production') {
            when {
                branch 'main'
            }
            steps {
                echo '========== Deploying to Cloud Run (Production) =========='
                script {
                    sh """
                        # Deploy with gradual traffic migration
                        gcloud run deploy ${CLOUD_RUN_SERVICE} \
                            --image=${IMAGE_NAME}:${IMAGE_TAG} \
                            --platform=managed \
                            --region=${GCP_REGION} \
                            --allow-unauthenticated \
                            --port=8080 \
                            --memory=1Gi \
                            --cpu=2 \
                            --min-instances=1 \
                            --max-instances=10 \
                            --set-env-vars="SPRING_PROFILES_ACTIVE=prod" \
                            --set-env-vars="DATABASE_NAME=${DATABASE_NAME}" \
                            --set-env-vars="DATABASE_USER=${DATABASE_USER}" \
                            --set-env-vars="DATABASE_PASSWORD=${DATABASE_PASSWORD}" \
                            --set-env-vars="JWT_SECRET=${JWT_SECRET}" \
                            --set-env-vars="CLOUD_SQL_INSTANCE_CONNECTION_NAME=${CLOUD_SQL_INSTANCE}" \
                            --add-cloudsql-instances=${CLOUD_SQL_INSTANCE} \
                            --timeout=300 \
                            --service-account=jenkins-deployer@${GCP_PROJECT_ID}.iam.gserviceaccount.com \
                            --no-traffic

                        echo "New revision deployed (no traffic yet)"

                        # Get the latest revision
                        LATEST_REVISION=\$(gcloud run services describe ${CLOUD_RUN_SERVICE} \
                            --region=${GCP_REGION} \
                            --format='value(status.latestCreatedRevisionName)')

                        echo "Latest revision: \$LATEST_REVISION"

                        # Gradually shift traffic: 10% -> 50% -> 100%
                        echo "Shifting 10% traffic to new revision..."
                        gcloud run services update-traffic ${CLOUD_RUN_SERVICE} \
                            --region=${GCP_REGION} \
                            --to-revisions=\$LATEST_REVISION=10

                        sleep 30

                        echo "Shifting 50% traffic to new revision..."
                        gcloud run services update-traffic ${CLOUD_RUN_SERVICE} \
                            --region=${GCP_REGION} \
                            --to-revisions=\$LATEST_REVISION=50

                        sleep 30

                        echo "Shifting 100% traffic to new revision..."
                        gcloud run services update-traffic ${CLOUD_RUN_SERVICE} \
                            --region=${GCP_REGION} \
                            --to-latest

                        echo "Production deployment completed ✓"
                    """
                }
            }
        }

        stage('Health Check - Production') {
            when {
                branch 'main'
            }
            steps {
                echo '========== Running Production Health Check =========='
                script {
                    def productionUrl = sh(
                        script: "gcloud run services describe ${CLOUD_RUN_SERVICE} --region=${GCP_REGION} --format='value(status.url)'",
                        returnStdout: true
                    ).trim()

                    echo "Production URL: ${productionUrl}"

                    // Wait for service to stabilize
                    sh "sleep 30"

                    // Run comprehensive health checks
                    sh """
                        echo "Running health check..."
                        HEALTH_STATUS=\$(curl -s ${productionUrl}/actuator/health | grep -o '"status":"UP"')

                        if [ -z "\$HEALTH_STATUS" ]; then
                            echo "❌ Health check failed!"
                            exit 1
                        fi

                        echo "✓ Health check passed"

                        # Test basic API endpoints
                        echo "Testing API endpoints..."
                        HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" ${productionUrl}/actuator/health)

                        if [ "\$HTTP_CODE" != "200" ]; then
                            echo "❌ API health check failed with status \$HTTP_CODE"
                            exit 1
                        fi

                        echo "✓ All health checks passed"
                    """

                    // Store the production URL
                    env.PRODUCTION_URL = productionUrl
                }
            }
        }

        stage('Tag Release') {
            when {
                branch 'main'
            }
            steps {
                echo '========== Tagging Release =========='
                script {
                    sh """
                        # Tag the image with version
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:release-${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:release-${IMAGE_TAG}

                        echo "Release tagged as: release-${IMAGE_TAG} ✓"
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                echo '========== Cleaning up local Docker images =========='
                script {
                    sh """
                        # Remove old local images to save space
                        docker images | grep ${APP_NAME} | awk '{print \$3}' | head -n -3 | xargs -r docker rmi || true

                        echo "Cleanup completed ✓"
                    """
                }
            }
        }
    }

    post {
        always {
            echo '========== Pipeline Execution Completed =========='
            // Clean workspace
            cleanWs()
        }

        success {
            echo '========== ✓ BUILD AND DEPLOYMENT SUCCESSFUL =========='
            script {
                def message = """
                ✅ Jenkins Pipeline Successful

                Project: ${env.JOB_NAME}
                Build: #${env.BUILD_NUMBER}
                Branch: ${env.GIT_BRANCH}

                Image: ${IMAGE_NAME}:${IMAGE_TAG}
                """

                if (env.BRANCH_NAME == 'main' && env.PRODUCTION_URL) {
                    message += "\nProduction URL: ${env.PRODUCTION_URL}"
                }

                echo message

                // Optional: Send Slack notification
                // slackSend color: 'good', message: message

                // Optional: Send email notification
                // emailext (
                //     subject: "✅ SUCCESS: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                //     body: message,
                //     to: "your-email@example.com"
                // )
            }
        }

        failure {
            echo '========== ❌ BUILD OR DEPLOYMENT FAILED =========='
            script {
                def message = """
                ❌ Jenkins Pipeline Failed

                Project: ${env.JOB_NAME}
                Build: #${env.BUILD_NUMBER}
                Branch: ${env.GIT_BRANCH}

                Console: ${env.BUILD_URL}console

                Please check the logs for details.
                """

                echo message

                // Optional: Send Slack notification
                // slackSend color: 'danger', message: message

                // Optional: Send email notification
                // emailext (
                //     subject: "❌ FAILURE: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                //     body: message,
                //     to: "your-email@example.com"
                // )
            }
        }

        unstable {
            echo '========== ⚠️ BUILD UNSTABLE =========='
            script {
                echo 'Build is unstable - some tests may have failed'
            }
        }
    }
}
