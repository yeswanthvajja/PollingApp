# Production Environment Variables
# Copy this file to .env.production and update with your values

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pollingdb
SPRING_DATASOURCE_USERNAME=polling_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# JWT Configuration (Generate a secure random key)
# To generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400000

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# CORS Configuration
ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_POLLING=INFO
